# ============================================
# Configuración de Jira (Server / Data Center / Cloud)
# ============================================

# Dominio de tu instancia de Jira (sin https:// ni rutas)
# Ejemplo: jiranext.tuempresa.com
NEXT_PUBLIC_JIRA_DOMAIN=jiranext.tuempresa.com

# Personal Access Token (PAT) o API Token generado desde tu perfil de Jira
JIRA_API_TOKEN=your-personal-access-token

# Email de usuario de Jira (opcional para Bearer, requerido si se usa Basic Auth)
JIRA_EMAIL=usuario@tuempresa.com

# Project Key de tu proyecto en Jira (ejemplo: PROB)
NEXT_PUBLIC_JIRA_PROJECT_KEY=PROB

# ============================================
# Configuración del Dashboard
# ============================================

# Intervalo de refresco automático en milisegundos (ej: 3600000 = 1 hora)
NEXT_PUBLIC_REFRESH_INTERVAL=3600000

# Título visible en el encabezado del dashboard
NEXT_PUBLIC_DASHBOARD_TITLE=Dashboard de Problemas

# Base path para integración con el Dashboard Portal y Nginx
NEXT_PUBLIC_BASE_PATH=/problemas

# ============================================
# Backend de Informes y PowerPoint (FastAPI)
# ============================================

# URL base del microservicio FastAPI (cso-incident-masivas-report/backend)
# Por defecto en desarrollo local: http://localhost:8000
BACKEND_REPORTS_URL=http://localhost:8000
